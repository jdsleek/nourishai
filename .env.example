# Get your free key at https://console.groq.com/keys
# Used ONLY server-side inside Next.js API routes — never bundled into the browser.
GROQ_API_KEY=

# Optional: override the model (defaults to llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant (faster), mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback / additional graders (OpenAI-compatible REST). Omit keys you do not use.
OPENROUTER_API_KEY=
# Use OpenRouter ":free" models only — see https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_HTTP_REFERER=https://your-app.up.railway.app
OPENROUTER_APP_TITLE=NourishAI Foundry

NVIDIA_API_KEY=
# NVIDIA Build NIM chat — see https://build.nvidia.com (model id matches API catalog)
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct

# Smart chain: tries each until success; each provider retries 429 / 5xx / empty replies.
# Default order avoids Groq’s tight TPM burst on long pasted essays.
FOUNDRY_GRADING_PROVIDER_ORDER=openrouter,nvidia,groq
# Same upstream may be retried 1–8 times (default 3) with exponential backoff before next provider.
# FOUNDRY_GRADE_LLM_ATTEMPTS=3

# FOUNDRY_GRADE_MAX_PROMPT_CHARS=4500
# FOUNDRY_GRADE_MAX_OUTPUT_CHARS=6500

# Postgres for Day 03 Foundry submissions (required on Railway for durable admin history)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Instructor admin (/foundry/admin); omit to default to 10101010
# FOUNDRY_ADMIN_PASSWORD=
