# Get your free key at https://console.groq.com/keys
# Used ONLY server-side inside Next.js API routes — never bundled into the browser.
GROQ_API_KEY=

# Optional: override the model (defaults to llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant (faster), mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback / additional graders (OpenAI-compatible REST). Omit keys you do not use.
OPENROUTER_API_KEY=
# Use OpenRouter ":free" models only — see https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_HTTP_REFERER=https://your-app.up.railway.app
OPENROUTER_APP_TITLE=NourishAI Foundry

NVIDIA_API_KEY=
# NVIDIA Build NIM chat — see https://build.nvidia.com (model id matches API catalog)
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct

# Smart chain: tries each until success; each provider retries 5xx / empty replies.
# OpenRouter “:free” often returns 429; put your most stable key first (see FOUNDRY_GRADE_429_MAX_ATTEMPTS).
# Example: groq,nvidia,openrouter
FOUNDRY_GRADING_PROVIDER_ORDER=openrouter,nvidia,groq
# Same upstream may be retried 1–8 times (default 3) with exponential backoff before next provider (non-429).
# FOUNDRY_GRADE_LLM_ATTEMPTS=3

# Separate budget for HTTP 429 (RPM/TPM). Default 1 = one try per provider, then failover (avoids ~90s on stuck OpenRouter).
# FOUNDRY_GRADE_429_MAX_ATTEMPTS=1

# FOUNDRY_GRADE_MAX_PROMPT_CHARS=4500
# FOUNDRY_GRADE_MAX_OUTPUT_CHARS=6500

# Postgres for Day 03 Foundry submissions (required on Railway for durable admin history)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Instructor admin (/foundry/admin); omit to default to 10101010
# FOUNDRY_ADMIN_PASSWORD=

# Facilitator session cookie signing — required in prod (long random)
# FACILITATOR_SESSION_SECRET=

# Optional banner on `/` (training home). Set before build — e.g. Next live class: Friday 10am PT — use your facilitator hub link.
# NEXT_PUBLIC_HOME_SESSION_NOTE=

# ── Offline Railway automation (never commit tokens) ──
# Account token → https://railway.app/account/tokens → then: npm run railway:bootstrap-training
# RAILWAY_TOKEN=
# NOURISHAI_RAILWAY_PROJECT_ID=
